# PostgreSQL (development values only; replace outside local development)
POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_dev_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Published application ports
API_PORT=8000
WEB_PORT=3000

# Backend runtime configuration
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
EVENT_STREAM_NAME=forge.events
EVENT_DLQ_STREAM_NAME=forge.events.dlq
EVENT_PUBLISH_BATCH_SIZE=50
EVENT_PUBLISH_INTERVAL_MS=500
EVENT_PROCESSING_LEASE_SECONDS=30
EVENT_MAX_RETRIES=5
EVENT_RETRY_BASE_SECONDS=1.0
EVENT_CONSUMER_BLOCK_MS=1000

# Phase 05 agent runtime. Mock is deterministic, local, and free.
MODEL_PROVIDER=mock
ALLOW_PAID_MODEL_CALLS=false

# Provider credentials belong only in .env. Enable a provider after adding its key.
OPENAI_ENABLED=true
OPENAI_API_KEY=
GEMINI_ENABLED=false
GEMINI_API_KEY=
OPENROUTER_ENABLED=false
OPENROUTER_DISCOVERY_ENABLED=true
OPENROUTER_CATALOG_TTL_SECONDS=3600
OPENROUTER_FREE_ONLY=true
OPENROUTER_API_KEY=

# JSON array of provider-neutral model profiles. Empty keeps the legacy MODEL_* aliases.
# Replace [] with a single-line JSON array after choosing actual provider model IDs.
# Required fields: alias, provider, model, tier, capabilities, enabled, paid, max_call_cost.
# Example (replace both model IDs with models enabled for your provider accounts):
# MODEL_CATALOG=[{"alias":"planner","provider":"gemini","model":"REPLACE_WITH_GEMINI_MODEL_ID","tier":"FREE","capabilities":["TEXT","REASONING","STRUCTURED_OUTPUT"],"enabled":true,"paid":false,"max_call_cost":0},{"alias":"developer_coding","provider":"gemini","model":"REPLACE_WITH_GEMINI_MODEL_ID","tier":"FREE","capabilities":["TEXT","CODING","TOOL_CALLING","STRUCTURED_OUTPUT"],"enabled":true,"paid":false,"max_call_cost":0}]
MODEL_CATALOG=[]
MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_TRANSIENT_MAX_ATTEMPTS=3
MODEL_RETRY_BASE_SECONDS=0.25
MODEL_PROVIDER_HEALTH_COOLDOWN_SECONDS=300
MODEL_FALLBACK_MAX_CANDIDATES=3
FORGE_DEV_MODE_ENABLED=false
FORGE_SELF_DEVELOPMENT_ENABLED=false
FORGE_DEV_CONTEXT_CHECKPOINT_RATIO=0.7
FORGE_DEV_SPECIALIST_LIMIT=2
STORE_MODEL_INPUTS=false
AGENT_RUN_STALE_SECONDS=300
MODEL_DEFAULT=gpt-5.4-mini
MODEL_FAST=gpt-5.4-nano
MODEL_REASONING=gpt-5.4
MODEL_CODING=gpt-5.4-mini
MODEL_PLANNER=gpt-5.4-mini
MODEL_DEVELOPER_FAST=gpt-5.4-nano
MODEL_DEVELOPER_CODING=gpt-5.4-mini
MODEL_DEVELOPER_REASONING=gpt-5.4
MODEL_QA_FAST=gpt-5.4-nano
MODEL_QA_VISUAL=gpt-5.4-mini
MAX_MODEL_CALLS_PER_TASK=24
MAX_MODEL_CALLS_PER_MISSION=100
MAX_FREE_MODEL_CALLS_PER_TASK=24
MAX_PAID_MODEL_CALLS_PER_TASK=8
MAX_MODEL_CALLS_PER_ITERATION=24
MAX_INPUT_TOKENS_PER_TASK=240000
MAX_OUTPUT_TOKENS_PER_TASK=48000
MODEL_BUDGET_WARNING_RATIO=0.8
CONTEXT_RECENT_OBSERVATIONS=3
DUPLICATE_TOOL_TURN_THRESHOLD=2
PRODUCT_QA_ENABLED=true
MODEL_PRICING={}
MAX_AI_SPEND_PER_TASK=
MAX_AI_SPEND_PER_MISSION=

# Phase 08 manually-triggered Mission planning and deterministic graph limits.
MISSION_MAX_AGENTS=8
MISSION_MAX_TASKS=30
MISSION_MAX_DEPENDENCIES=100
MISSION_MAX_PLANNING_ATTEMPTS=3
PLANNING_RUN_STALE_SECONDS=300
PLANNER_REQUEST_TIMEOUT_SECONDS=30
PLANNER_PROVIDER_MAX_ATTEMPTS=3
PLANNER_RETRY_BASE_SECONDS=0.5

# Phase 06 controlled tools. Shell remains disabled and is not implemented.
TOOLS_ENABLED=true
FILESYSTEM_LIST_ENABLED=true
FILESYSTEM_READ_ENABLED=true
FILESYSTEM_WRITE_ENABLED=true
SHELL_RUN_ENABLED=false
TOOL_WORKSPACE_ROOT=/workspaces
FILESYSTEM_TOOL_TIMEOUT_SECONDS=10
TOOL_FILE_READ_MAX_BYTES=262144
TOOL_FILE_WRITE_MAX_BYTES=262144
TOOL_OBSERVATION_MAX_CHARS=50000
AGENT_MAX_TOOL_STEPS=10
TOOL_CALL_STALE_SECONDS=300

# Phase 07 deterministic orchestration. Existing installations stay paused after migration.
AUTONOMY_ENABLED=false

# Phase 09 controlled development runtime. The model selects action IDs; it never supplies shell.
DEVELOPMENT_ENABLED=true
DEVELOPMENT_MAX_EXECUTIONS=8
DEVELOPMENT_BOOTSTRAP_ENABLED=true
DEVELOPMENT_BOOTSTRAP_MAX_ATTEMPTS=3
DEVELOPER_MAX_STEPS=20
DEVELOPER_MAX_FIX_ATTEMPTS=3
DEVELOPMENT_PROJECT_LEASE_SECONDS=900
DEVELOPMENT_OUTPUT_MAX_BYTES=50000
DEVELOPMENT_TEST_TIMEOUT_SECONDS=300
DEVELOPMENT_BUILD_TIMEOUT_SECONDS=300
DEVELOPMENT_LINT_TIMEOUT_SECONDS=120
DEVELOPMENT_INSTALL_TIMEOUT_SECONDS=600
ORCHESTRATOR_RECONCILE_INTERVAL_SECONDS=5
ORCHESTRATOR_RECOVERY_INTERVAL_SECONDS=10
WORKER_POLL_INTERVAL_MS=500
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_STALE_SECONDS=30
AGENT_WORKER_CONCURRENCY=2
FORGE_MAX_CONCURRENT_TASKS=4
JOB_LEASE_SECONDS=60
JOB_LEASE_RENEW_INTERVAL_SECONDS=20
JOB_RETRY_BASE_SECONDS=5
EXECUTION_JOB_MAX_ATTEMPTS=3
WORKER_SHUTDOWN_GRACE_SECONDS=30

# Phase 2: opt-in Dev Mode services. Repository must exactly match the allowlist.
FORGE_DEV_FREE_ONLY=true
FORGE_DEV_REPOSITORY_PATH=
FORGE_DEV_ALLOWED_REPOSITORY=
FORGE_DEV_WORKTREE_ROOT=
# Used only by docker-compose.self-dev.yml. It must be an absolute host path.
FORGE_DEV_REPOSITORY_HOST_PATH=
FORGE_DEV_CONTEXT_LIMIT=32768
FORGE_DEV_CONTEXT_RESERVE_TOKENS=2048
FORGE_DEV_MAX_ROLLOVERS=4
FORGE_DEV_TOOL_REPAIR_LIMIT=2
FORGE_DEV_STAGNATION_LIMIT=4
FORGE_DEV_SPECIALIST_CONTEXT_CHARS=12000
OPENROUTER_PROBE_TTL_SECONDS=3600
OPENROUTER_PROBE_TIMEOUT_SECONDS=30
OPENROUTER_LIVE_PROBE_CANDIDATES=12
FORGE_BROWSER_ENABLED=false
FORGE_RUN_LIVE_OPENROUTER_TESTS=false
